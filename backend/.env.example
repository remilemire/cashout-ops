# backend/.env.example

# Keep comments on their own line — never inline after a value. dotenv does not
# reliably strip an inline "# comment": on an empty value the comment text
# BECOMES the value (e.g. `RESEND_API_KEY= # comment` sets it to "# comment").

# Settings are grouped: each section below maps to one nested settings model,
# so APP_ENV is settings.app.ENV, STORAGE_LOCAL_DIR is settings.storage.LOCAL_DIR,
# and so on. A few variables keep an unprefixed conventional name because
# something outside this app supplies or expects it — they are marked below.

# --- app ---

# prod | dev
APP_ENV=prod

# Public base URL of the SPA, used to build emailed sign-in links. The dev
# default targets the Vite server; production must set
# https://cashout-ops.onrender.com.
APP_BASE_URL=http://localhost:5173

# --- database and Redis ---

# Required. Unprefixed: hosting platforms inject DATABASE_URL under that name,
# and alembic reads it straight from the environment.
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/cashout_ops

# Required.
REDIS_URL=redis://localhost:6379/0

# --- bootstrap ---

# The owner account a fresh deployment creates for itself. The full name is
# given to that account when a first passwordless sign-in bootstraps it.
BOOTSTRAP_OWNER_EMAIL=owner@test.com
BOOTSTRAP_OWNER_FULL_NAME=Owner

# --- auth ---

AUTH_SESSION_TTL_DAYS=7

# Email challenges (sign-in link emailed on login). The challenge — and with
# it the link and its one-time code — expires this long after initiation.
AUTH_CHALLENGE_TTL_MINUTES=15

# OAuth sign-in flows (state kept in Redis plus the oauth_flow cookie) expire
# this long after they start.
AUTH_OAUTH_FLOW_TTL_MINUTES=10

# Google OAuth sign-in credentials. There is no enablement variable: Google
# sign-in is on exactly when both are set, and boot fails on just one of the
# two. Unprefixed: Google's own conventional names. Create them in Google
# Cloud Console with the authorized redirect URI:
# <APP_BASE_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email ---

# EMAIL_PROVIDER selects the client (console | resend): console logs the
# message (dev default; boots without a key), RESEND sends for real.
# RESEND_API_KEY is required when EMAIL_PROVIDER=resend, and keeps the vendor's
# own conventional name. EMAIL_FROM is the sender for all mail.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Whiskey District <onboarding@resend.dev>

# --- AI ---

# AI_MODEL selects the model and, with it, the provider whose client is built
# at startup. It must be one of the models listed in app/core/ai_models.py
# (AI_PROVIDER_MODELS) — boot fails otherwise. Each provider lists a default,
# a cheap, and a premium model there; this is Anthropic's default.
AI_MODEL=claude-sonnet-5

# Per-operation output-token budgets (conservative defaults; raise if analyses
# fail with the OUTPUT_LIMIT_REACHED error code).
AI_CLASSIFICATION_MAX_TOKENS=512
AI_EXTRACTION_MAX_TOKENS=2048

# Only the key for AI_MODEL's provider is required. Unprefixed: each is the
# vendor's own conventional variable name.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- document storage ---

# STORAGE_PROVIDER selects the client (local | s3). The selected provider's
# settings are required and the other's are ignored: local writes under
# STORAGE_LOCAL_DIR, s3 stores objects in S3_BUCKET and needs S3_REGION. A
# missing value fails at startup. The S3 pair is unprefixed, sitting alongside
# the AWS chain's own variables; AWS credentials come from that chain (env
# vars, profile, instance role), not from here.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/documents
S3_BUCKET=
S3_REGION=

# Largest single document accepted by the upload endpoint, in megabytes.
STORAGE_MAX_DOCUMENT_SIZE_MB=20

# --- outbox dispatch ---

# Workers poll for pending messages; failed attempts retry with exponential
# backoff (base * 2^(attempt-1), capped) until the attempts run out and the
# message dead-letters.
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BATCH_SIZE=1
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_CLAIM_TTL_SECONDS=30.0
OUTBOX_BACKOFF_BASE_SECONDS=5.0
OUTBOX_BACKOFF_CAP_SECONDS=900.0

# --- rate limits ---

# Fixed 1-hour windows; counters live in Redis under rate_limit:*. Per-IP cap
# on each anonymous auth endpoint, sign-in emails per address (real or decoy),
# per-user cashout document uploads, and per-user AI re-extractions.
RATE_LIMIT_AUTH_IP_PER_HOUR=20
RATE_LIMIT_INITIATE_EMAIL_PER_HOUR=5
RATE_LIMIT_UPLOADS_PER_USER_PER_HOUR=30
RATE_LIMIT_EXTRACTS_PER_USER_PER_HOUR=15
