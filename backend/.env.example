# backend/.env.example

# Keep comments on their own line — never inline after a value. dotenv does not
# reliably strip an inline "# comment": on an empty value the comment text
# BECOMES the value (e.g. `RESEND_API_KEY= # comment` sets it to "# comment").

# prod | dev
ENVIRONMENT=prod

# Required.
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/cashout_ops

# Redis connection URL (required).
REDIS_URL=redis://localhost:6379/0

SESSION_TTL_DAYS=7
INVITATION_TTL_DAYS=7

ADMIN_EMAIL=admin@test.com

# Email delivery. EMAIL_PROVIDER selects the client (CONSOLE | RESEND): CONSOLE
# logs the message (dev default; boots without a key), RESEND sends for real.
# RESEND_API_KEY is required when EMAIL_PROVIDER=RESEND. EMAIL_FROM is the
# sender for all mail.
EMAIL_PROVIDER=CONSOLE
RESEND_API_KEY=
EMAIL_FROM=Whiskey District <onboarding@resend.dev>

# Email verification (numeric code emailed on registration).
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# Outbox dispatch. Workers poll for pending messages; failed attempts retry
# with exponential backoff (base * 2^(attempt-1), capped) until the attempts
# run out and the message dead-letters.
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BATCH_SIZE=1
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_CLAIM_TTL_SECONDS=30.0
OUTBOX_BACKOFF_BASE_SECONDS=5.0
OUTBOX_BACKOFF_CAP_SECONDS=900.0

# Document AI. AI_PROVIDER selects the client (ANTHROPIC | OPENAI | GEMINI);
# only that provider's key is required. The model per provider is fixed in
# app/core/config.py (AI_MODELS) — there is no AI_MODEL env override.
AI_PROVIDER=ANTHROPIC
# Per-operation output-token budgets (conservative defaults; raise if analyses
# fail with the OUTPUT_LIMIT_REACHED error code).
AI_CLASSIFICATION_MAX_TOKENS=512
AI_EXTRACTION_MAX_TOKENS=2048

# Only the selected AI_PROVIDER's key is required.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=
GEMINI_API_KEY=

DOCUMENT_STORAGE_DIR=storage/documents
