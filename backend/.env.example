# backend/.env.example

ENVIRONMENT=prod # prod | dev

DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/cashout_ops # required

SESSION_TTL_DAYS=7

ADMIN_EMAIL=admin@test.com

# Document AI. AI_PROVIDER selects the client; only that provider's key is
# required. The model per provider is fixed in app/core/config.py (AI_MODELS) —
# there is no AI_MODEL env override.
AI_PROVIDER=ANTHROPIC # ANTHROPIC | OPENAI | GEMINI
# Per-operation output-token budgets (conservative defaults; raise if analyses
# fail with the TRUNCATED error code).
AI_CLASSIFICATION_MAX_TOKENS=512
AI_EXTRACTION_MAX_TOKENS=2048

ANTHROPIC_API_KEY=your-anthropic-api-key # required when AI_PROVIDER=ANTHROPIC
OPENAI_API_KEY= # required when AI_PROVIDER=OPENAI
GEMINI_API_KEY= # required when AI_PROVIDER=GEMINI

DOCUMENT_STORAGE_DIR=storage/documents
