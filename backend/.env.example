# backend/.env.example

# Keep comments on their own line — never inline after a value. dotenv does not
# reliably strip an inline "# comment": on an empty value the comment text
# BECOMES the value (e.g. `RESEND_API_KEY= # comment` sets it to "# comment").

# prod | dev
ENVIRONMENT=prod

# Required.
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/cashout_ops

# Redis connection URL (required).
REDIS_URL=redis://localhost:6379/0

SESSION_TTL_DAYS=7

OWNER_EMAIL=owner@test.com

# Full name given to the OWNER_EMAIL account when a first passwordless sign-in
# bootstraps it as the owner.
OWNER_FULL_NAME=Owner

# Email delivery. EMAIL_PROVIDER selects the client (CONSOLE | RESEND): CONSOLE
# logs the message (dev default; boots without a key), RESEND sends for real.
# RESEND_API_KEY is required when EMAIL_PROVIDER=RESEND. EMAIL_FROM is the
# sender for all mail.
EMAIL_PROVIDER=CONSOLE
RESEND_API_KEY=
EMAIL_FROM=Whiskey District <onboarding@resend.dev>

# Public base URL of the SPA, used to build emailed sign-in links. The dev
# default targets the Vite server; production must set
# https://cashout-ops.onrender.com.
APP_BASE_URL=http://localhost:5173

# Email challenges (sign-in link emailed on login). The challenge — and with
# it the link and its one-time code — expires this long after initiation.
EMAIL_CHALLENGE_TTL_MINUTES=15

# Rate limits (fixed 1-hour windows; counters live in Redis under
# rate_limit:*): per-IP cap on each anonymous auth endpoint, sign-in emails
# per address (real or decoy), per-user cashout document uploads, and per-user
# AI re-extractions.
RATE_LIMIT_AUTH_IP_PER_HOUR=20
RATE_LIMIT_INITIATE_EMAIL_PER_HOUR=5
RATE_LIMIT_UPLOADS_PER_USER_PER_HOUR=30
RATE_LIMIT_EXTRACTS_PER_USER_PER_HOUR=15

# Outbox dispatch. Workers poll for pending messages; failed attempts retry
# with exponential backoff (base * 2^(attempt-1), capped) until the attempts
# run out and the message dead-letters.
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BATCH_SIZE=1
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_CLAIM_TTL_SECONDS=30.0
OUTBOX_BACKOFF_BASE_SECONDS=5.0
OUTBOX_BACKOFF_CAP_SECONDS=900.0

# Document AI. AI_MODEL selects the model and, with it, the provider whose
# client is built at startup. It must be one of the models listed in
# app/core/ai.py (AI_PROVIDER_MODELS) — boot fails otherwise.
AI_MODEL=claude-sonnet-4-6
# Per-operation output-token budgets (conservative defaults; raise if analyses
# fail with the OUTPUT_LIMIT_REACHED error code).
AI_CLASSIFICATION_MAX_TOKENS=512
AI_EXTRACTION_MAX_TOKENS=2048

# Only the key for AI_MODEL's provider is required.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=
GEMINI_API_KEY=

# Document storage. DOCUMENT_STORAGE_PROVIDER selects the client (LOCAL | S3).
# The selected provider's settings are required and the other's are ignored:
# LOCAL writes under LOCAL_STORAGE_DIR, S3 stores objects in S3_BUCKET and
# needs S3_REGION. A missing value fails at startup. AWS credentials come from
# the standard AWS chain (env vars, profile, instance role), not from here.
DOCUMENT_STORAGE_PROVIDER=LOCAL
LOCAL_STORAGE_DIR=storage/documents
S3_BUCKET=
S3_REGION=

# Largest single document accepted by the upload endpoint, in megabytes.
MAX_DOCUMENT_SIZE_MB=20
